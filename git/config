[alias]
    c = commit
    ca = commit --amend
    cm = commit -m
    co = checkout
    d = diff
    ds = diff --staged
    l = log --oneline --graph
    s = status

[fetch]
    prune = true

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[rebase]
    autoStash = true

[url "git@github.com:"]
	insteadOf = gh:
[url "git@gitlab.com:"]
	insteadOf = glab:

[include]
    path = local.config
